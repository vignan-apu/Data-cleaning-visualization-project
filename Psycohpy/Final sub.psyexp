        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="You will see the names of colours on the screen, one at a time.&amp;#10;&amp;#10;Your task is to press the key that matches the INK COLOUR of the word,&amp;#10;not the word meaning.&amp;#10;&amp;#10;For example, if the word BLUE is written in red colour,&amp;#10;the correct answer is RED.&amp;#10;&amp;#10;Key responses:&amp;#10;R = Red&amp;#10;G = Green&amp;#10;B = Blue&amp;#10;Y = Yellow&amp;#10;&amp;#10;Press SPACE to start a short practice round." valType="str" updates="constant" name="text"/>
